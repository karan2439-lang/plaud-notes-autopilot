{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "maxLength": 60,
      "description": "Short topic label for client, project, or subject (e.g. acme-corp, roadmap-planning, misc)"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Short human-readable title for the recording"
    },
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "2-4 sentence summary written in your own words"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "description": "3-8 bullet points of substantive detail, decisions, numbers, or key insights"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "description": "Action item description"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "maxLength": 10
              },
              {
                "type": "null"
              }
            ],
            "description": "Due date in YYYY-MM-DD format if stated or clearly implied, otherwise null"
          }
        },
        "required": ["text", "due_date"],
        "additionalProperties": false
      },
      "description": "List of every action item or task identified"
    }
  },
  "required": ["topic", "title", "summary", "key_points", "action_items"],
  "additionalProperties": false
}
